#
# NOTE! Don't add files that are generated in specific
# subdirectories here. Add them in the ".gitignore" file
# in that subdirectory instead.
#
# NOTE! Please use 'git ls-files -i --exclude-standard'
# command after changing this file, to see if there are
# any tracked files which get ignored after the change.
#
# Normal rules (sorted alphabetically)
#
# SPDX-License-Identifier: GPL-2.0-only
# Android Kernel Custom .gitignore

# ------------------------------------
# 1. Compiled Objects & Archives
# ------------------------------------
*.o
*.a
*.s
*.ko
*.so
*.so.dbg
*.mod
*.mod.c
*.i
*.lst
*.symtypes
*.order
*.elf
*.bin
*.gz
*.bz2
*.lzma
*.xz
*.lzo
*.lz4
*.zst
*.patch
*.gcno
*.gcda

# ------------------------------------
# 2. Kernel Images & Map Files
# ------------------------------------
/vmlinux
/vmlinux.32
/vmlinux.map
/vmlinux.symvers
/vmlinuz
/System.map
/Module.markers
/Module.symvers
/modules.builtin
/modules.builtin.modinfo
/modules.order
dtbs-list

# ------------------------------------
# 3. Custom Output & Zips (Crucial)
# ------------------------------------
# Ignores your build output folder and AnyKernel3 packaging directory
/out/
/AnyKernel3/
*.zip

# ------------------------------------
# 4. Logs & Text Outputs
# ------------------------------------
*.log
build_log.txt
last_kmsg.txt
dmesg.txt

# ------------------------------------
# 5. IDEs, Editors & Temp Files
# ------------------------------------
.vscode/
.idea/
*.swp
*~
*.orig
*.rej
\#*\#
